# Copy this file to .env and adjust.
# URL of the FastAPI backend (no trailing slash).
#  - npm run dev   : the Vite dev server proxies /api -> this URL
#  - npm run build : the built app calls this URL directly (backend must allow
#                    the frontend origin via CORS — see backend ALLOWED_ORIGINS)
VITE_BACKEND_URL=http://127.0.0.1:8000
